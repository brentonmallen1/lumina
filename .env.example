# ════════════════════════════════════════════════════════════════════════
#  Lumina — configuration
#  Copy to .env and edit. docker compose reads it automatically.
#
#  Most settings below only SEED the database on first run. After that the
#  Settings UI is the source of truth and changes apply without a restart.
#  Values marked [deploy] are read on every start instead.
#  Full reference: docs/configuration.md
# ════════════════════════════════════════════════════════════════════════

# ── Docker / deployment [deploy] ─────────────────────────────────────────
# Registry for `just release` and the Playwright base image. Leave blank to
# build everything locally (`just build-playwright-base` then `just up`).
DOCKER_REGISTRY=
DOCKER_TAG=latest

# Host port for the UI and API.
APP_PORT=8880
# Optional second host port for the API (uncomment the line in docker-compose.yml).
# API_PORT=8881

# GPU: requires nvidia-container-toolkit on the host.
ENABLE_GPU=false
NVIDIA_VISIBLE_DEVICES=all

# Host paths for persistent data.
MODELS_VOLUME=./volumes/models
AUDIO_CACHE_VOLUME=./volumes/audio_cache
DATA_VOLUME=./volumes/data

# Container timezone (scheduled feed checks use it).
TZ=UTC

# Comma-separated origins allowed to call the API from another site. Blank = same origin only.
CORS_ORIGINS=

# ── Access ────────────────────────────────────────────────────────────────
# Basic Auth for the UI and API.
AUTH_ENABLED=false
AUTH_USERNAME=admin
AUTH_PASSWORD=
# Token for scripts: "Authorization: Bearer <key>" or "X-API-Key: <key>".
# Generate with: openssl rand -hex 32
API_KEY=

# ── Ollama (LLM) ──────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4
# Seconds to wait between streamed tokens before giving up.
OLLAMA_TIMEOUT=120
# Use the model's native reasoning when it supports it.
OLLAMA_THINKING_ENABLED=true
# Tokens reserved for each reply (reasoning + answer).
OLLAMA_OUTPUT_BUDGET=32768
# Context window: each model's own maximum unless overridden.
#   OLLAMA_CONTEXT_OVERRIDES — JSON {"model": tokens}, e.g. {"gemma4:31b": 131072}
#   OLLAMA_CONTEXT_CAP       — upper limit for every model (blank = none)
OLLAMA_CONTEXT_OVERRIDES={}
OLLAMA_CONTEXT_CAP=
# Treat the model as vision-capable even if Ollama doesn't report it.
OLLAMA_VISION_OVERRIDE=false

# ── Transcription ─────────────────────────────────────────────────────────
# faster-whisper | whisper | canary (GPU) | qwen-audio (GPU)
TRANSCRIPTION_ENGINE=faster-whisper
# tiny | base | small | medium | large-v3 | large-v3-turbo
WHISPER_MODEL_SIZE=large-v3-turbo
# faster-whisper quantization: int8 (CPU) | int8_float16 | float16 (GPU) | float32
COMPUTE_TYPE=int8
# ISO 639-1 code, or blank to auto-detect.
LANGUAGE=en
CANARY_MODEL=nvidia/canary-qwen-2.5b
QWEN_MODEL=Qwen/Qwen2.5-Audio-3B-Instruct

# ── Jobs and uploads ──────────────────────────────────────────────────────
MAX_CONCURRENT_JOBS=2
MAX_UPLOAD_SIZE_MB=500
# Delete uploaded audio after this many hours (0 = keep).
AUDIO_CACHE_TTL_HOURS=72

# ── Audio enhancement defaults ────────────────────────────────────────────
ENHANCE_NORMALIZE=false
ENHANCE_DENOISE=false
ENHANCE_ISOLATE=false
ENHANCE_UPSAMPLE=false

# ── Text to speech ────────────────────────────────────────────────────────
TTS_ENABLED=true
TTS_VOICE=af_bella

# ── Integrations ──────────────────────────────────────────────────────────
# HuggingFace token, needed for speaker diarization (pyannote.audio).
HF_TOKEN=
# Netscape-format cookies for YouTube (age-restricted videos, rate limits).
# Easier to paste in Settings → YouTube.
YOUTUBE_COOKIES=

# Mealie: enables "Send to Mealie" on recipe results (Mealie → profile → API Tokens).
MEALIE_URL=
MEALIE_API_TOKEN=

# Browser tab title / app name.
APP_NAME=Lumina
